# --- EAR API ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/unsaid
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3000
ADMIN_ORIGINS=http://localhost:3100
# true ONLY behind a trusted reverse proxy (Vercel/Render/Next rewrite). Leave false if the API is reachable directly.
TRUST_PROXY=false
# 32+ random chars. REQUIRED in production (used to HMAC IPs / bodies / proof-of-work).  openssl rand -hex 32
APP_SECRET=dev-only-secret-change-me-0123456789abcdef
POW_DIFFICULTY=16
SOURCE_HASH_RETENTION_DAYS=30
# email: outbox (dev: stored in DB, readable at /api/v1/dev/outbox) | log | smtp
EMAIL_TRANSPORT=outbox
EMAIL_FROM="EAR <no-reply@ear.local>"
# SMTP_URL=smtps://user:pass@smtp.example.com
# storage: local | s3
STORAGE_DRIVER=local
MEDIA_DIR=.data/media
# S3_BUCKET= S3_REGION=auto S3_ENDPOINT= S3_PUBLIC_BASE_URL=
EXPO_PUSH_ENABLED=true
# `npm run db:seed` creates this admin (dev defaults — change them anywhere real)
ADMIN_SEED_EMAIL=admin@ear.local
ADMIN_SEED_PASSWORD=change-me-please-123
