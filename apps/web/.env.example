# Where the Fastify API lives. Next rewrites /api/v1/* and /media/* to it. BUILD-TIME on Vercel (baked into rewrites + CSP).
API_URL=http://localhost:4000
# Public origin of this web app (used for canonical URLs and share links). Build-time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
